# =====================================================================
# FraudGuard AI - Environment Configuration Example
# Copy to .env and adjust variables for your local or production setup.
# =====================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default # Use 'mysql' for MySQL 8.x, or 'default' for embedded H2

# MySQL Database Configuration (Used when profile=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fraud_detection_db
DB_USER=frauduser
DB_PASSWORD=fraudpassword

# Python ML Microservice Configuration
ML_SERVICE_URL=http://localhost:5001
ML_PORT=5001

# Security & JWT Token Signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload Thresholds
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
